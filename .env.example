# CyberSkill — environment template (self-hosted stack). Copy to .env and fill in.
# .env is gitignored; never commit real secrets.

# Public site URL (build-time inlined for SEO/canonical/OG).
NEXT_PUBLIC_SITE_URL=https://cyberskill.online
NODE_ENV=production

# --- PostgreSQL (self-hosted) ---------------------------------------------
# These three configure the postgres container; DATABASE_URL is what the app uses.
POSTGRES_USER=cyberskill
POSTGRES_PASSWORD=__REDACTED_see_offbox_env__
POSTGRES_DB=cyberskill
# App -> Postgres over the private docker network (service alias 'db'):
DATABASE_URL=postgres://cyberskill:__REDACTED_see_offbox_env__@db:5432/cyberskill

# --- Auth.js / NextAuth v5 (Credentials provider, JWT sessions) ------------
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=__REDACTED_see_offbox_env__
NEXTAUTH_URL=https://cyberskill.online
AUTH_TRUST_HOST=true
# First admin, seeded idempotently by scripts/seed-admin.mjs:
ADMIN_EMAIL=admin@cyberskill.online
ADMIN_PASSWORD=__REDACTED_see_offbox_env__

# --- Telegram (outbound notifications only; optional) ----------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ORDERS_CHAT_ID=

# --- Cron cleanup auth -----------------------------------------------------
# Generate with: openssl rand -hex 32
CRON_SECRET=__REDACTED_see_offbox_env__

# --- AI responder (kept OFF by default) ------------------------------------
AI_CHAT_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
