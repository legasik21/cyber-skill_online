# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# heavy local source clips for the hero video — only the optimized
# derivatives (hero-bg.mp4 / hero-bg.webm / hero-poster.webp) are committed
/public/cyberskill_bg_hero.mp4
/public/bg_cyberskill.webm

# DB backups (generated)
backups/

# .env.example is a committed template (the .env* rule above would otherwise exclude it)
!.env.example

# Local agent tooling (installed skills / lockfile)
.agents/
skills-lock.json
